{
  "name": "alphaclawxiv",
  "version": "0.2.1",
  "description": "Native OpenClaw plugin for AlphaXiv OAuth, live MCP paper discovery, PDF analysis, and repository reading.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Riddhimaan-Senapati/AlphaClawXiv#readme",
  "bugs": {
    "url": "https://github.com/Riddhimaan-Senapati/AlphaClawXiv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Riddhimaan-Senapati/AlphaClawXiv.git",
    "directory": "plugins/alphaclawxiv"
  },
  "keywords": [
    "openclaw",
    "clawhub",
    "alphaxiv",
    "arxiv",
    "mcp",
    "oauth",
    "research",
    "papers"
  ],
  "bin": {
    "alphaclawxiv": "bin/run.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@oclif/core": "^4.2.0",
    "typebox": "^1.3.25"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "openclaw": {
    "extensions": [
      "dist/index.js"
    ],
    "runtimeExtensions": [
      "dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1",
      "minGatewayVersion": ">=2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "oclif": {
    "bin": "alphaclawxiv",
    "dirname": "alphaclawxiv",
    "topicSeparator": " ",
    "commands": "./dist/commands"
  },
  "engines": {
    "node": ">=20"
  }
}
