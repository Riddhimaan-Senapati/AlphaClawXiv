{
  "id": "alphaclawxiv",
  "name": "AlphaClawXiv",
  "description": "Native OpenClaw OAuth, live AlphaXiv MCP paper discovery, PDF analysis, and repository-reading tools.",
  "version": "0.1.7",
  "enabledByDefault": true,
  "activation": {
    "onStartup": true,
    "onCommands": [
      "alphaclawxiv",
      "alphaxiv"
    ]
  },
  "contracts": {
    "tools": [
      "discover_papers",
      "get_paper_content",
      "answer_pdf_queries",
      "read_files_from_github_repository"
    ]
  },
  "toolMetadata": {
    "discover_papers": {
      "optional": false
    },
    "get_paper_content": {
      "optional": false
    },
    "answer_pdf_queries": {
      "optional": false
    },
    "read_files_from_github_repository": {
      "optional": false
    }
  },
  "commandAliases": [
    {
      "name": "alphaclawxiv"
    },
    {
      "name": "alphaxiv"
    }
  ],
  "skills": [
    "./skills"
  ],
  "setup": {
    "requiresRuntime": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mcpUrl": {
        "type": "string",
        "default": "https://api.alphaxiv.org/mcp/v1"
      },
      "serverName": {
        "type": "string",
        "default": "alphaxiv"
      },
      "connectionTimeoutMs": {
        "type": "number",
        "minimum": 1,
        "default": 30000
      }
    }
  },
  "uiHints": {
    "mcpUrl": {
      "label": "AlphaXiv MCP URL",
      "help": "Hosted AlphaXiv Streamable HTTP MCP endpoint."
    },
    "serverName": {
      "label": "MCP Server Name",
      "help": "Name used in OpenClaw's mcp.servers map."
    },
    "connectionTimeoutMs": {
      "label": "Connection Timeout",
      "help": "Timeout used by OpenClaw when connecting to the hosted AlphaXiv MCP endpoint.",
      "advanced": true
    }
  }
}
